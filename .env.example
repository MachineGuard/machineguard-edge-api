MACHINEGUARD_API_URL=http://localhost:8080
# Provision with an active organization ADMIN in Core; keep the issued value private.
EDGE_DEVICE_CREDENTIAL=
# Copy expiresAt from Core's gateway metadata for this credential; empty means unknown.
EDGE_DEVICE_CREDENTIAL_EXPIRES_AT=
EDGE_CREDENTIAL_WARNING_SECONDS=604800
EDGE_PORT=5000
EDGE_WSGI_THREADS=4
EDGE_GATEWAY_ID=gateway-local
EDGE_DATABASE_PATH=edge.db
EDGE_SYNC_BATCH_SIZE=100
EDGE_BUFFER_CAPACITY=10000

# Required, independent administrative secret (32+ random bytes); never give it to nodes.
EDGE_ADMIN_KEY=
# Stable operator identity for the calibration audit; not supplied by a request body.
EDGE_ADMIN_ID=local-admin
# Loopback is always allowed. Optional extra client IPs, comma-separated; no CIDRs/wildcards.
# For local access via the laptop AP address, explicitly list that laptop IP only.
EDGE_ADMIN_ALLOWED_IPS=
EDGE_BIND_HOST=127.0.0.1
EDGE_MAX_CONTENT_BYTES=65536
EDGE_MAX_TEMPERATURE_OFFSET=10
EDGE_MAX_HUMIDITY_OFFSET=20
EDGE_TEMPERATURE_MIN=-40
EDGE_TEMPERATURE_MAX=80
EDGE_HUMIDITY_MIN=0
EDGE_HUMIDITY_MAX=100
EDGE_MAX_FUTURE_SECONDS=60
EDGE_MAX_READING_AGE_DAYS=30
EDGE_MIN_CAPTURED_AT=2026-01-01T00:00:00Z
# Automatic delivery: polling, bounded exponential backoff and partition limits.
EDGE_DELIVERY_POLL_SECONDS=1
EDGE_DELIVERY_BACKOFF_SECONDS=2
EDGE_DELIVERY_MAX_BACKOFF_SECONDS=60
EDGE_DELIVERY_MAX_REQUESTS=16
EDGE_DELIVERY_MAX_DEPTH=9
EDGE_DELIVERY_HTTP_TIMEOUT_SECONDS=5
EDGE_DELIVERY_LEASE_SECONDS=30
EDGE_NODE_PAUSE_SECONDS=60
EDGE_OFFLINE_GRACE_RATIO=0.25

# Respaldo de la base con scripts/edge-backup.py (ver docs/arranque-y-respaldo.md).
# Vacío = carpeta backups junto a EDGE_DATABASE_PATH.
EDGE_BACKUP_DIR=
EDGE_BACKUP_KEEP=7

# Optional independent secondary output: one node owns this channel. No remote setup is performed.
THINGSPEAK_ENABLED=false
THINGSPEAK_DEVICE_CODE=
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_WRITE_KEY=
THINGSPEAK_WINDOW_SECONDS=20
THINGSPEAK_CAPACITY=1000
THINGSPEAK_MAX_SAMPLES=500
THINGSPEAK_SCAN_SIZE=100
THINGSPEAK_POLL_SECONDS=1
THINGSPEAK_BACKOFF_SECONDS=20
THINGSPEAK_MAX_BACKOFF_SECONDS=300
THINGSPEAK_HTTP_SECONDS=5
