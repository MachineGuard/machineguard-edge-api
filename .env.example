MACHINEGUARD_API_URL=http://localhost:8080
# Provision with an active organization ADMIN in Core; keep the issued value private.
EDGE_DEVICE_CREDENTIAL=
EDGE_GATEWAY_ID=gateway-local
EDGE_DATABASE_PATH=edge.db
EDGE_SYNC_BATCH_SIZE=100
EDGE_BUFFER_CAPACITY=10000

# Required, independent administrative secret (32+ random bytes); never give it to nodes.
EDGE_ADMIN_KEY=replace-with-at-least-32-random-bytes
# Stable operator identity for the calibration audit; not supplied by a request body.
EDGE_ADMIN_ID=local-admin
EDGE_BIND_HOST=127.0.0.1
EDGE_MAX_CONTENT_BYTES=65536
EDGE_MAX_TEMPERATURE_OFFSET=10
EDGE_MAX_HUMIDITY_OFFSET=20
EDGE_TEMPERATURE_MIN=-40
EDGE_TEMPERATURE_MAX=80
EDGE_HUMIDITY_MIN=0
EDGE_HUMIDITY_MAX=100
